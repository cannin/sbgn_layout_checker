<?xml version='1.0' encoding='utf-8'?>
<sbgn xmlns:layout-test="https://github.com/cannin/sbgn_layout_checker/test" xmlns="http://sbgn.org/libsbgn/0.3">
  <map id="4_2_9_compartments_1" language="process description">
    <extension>
      <layout-test:expectedViolation section="4.2.9" scenario="4_2_9_compartments" variant="1" checkerFinding="process_outside_participant_compartment" />
    </extension>
    <glyph id="cell" class="compartment">
      <label text="C">
        <bbox x="5" y="70" w="10" h="8" />
      </label>
      <bbox x="0" y="0" w="130" h="80" />
    </glyph>
    <glyph id="a" class="macromolecule" compartmentRef="cell">
      <label text="A">
        <bbox x="15" y="26" w="10" h="8" />
      </label>
      <bbox x="10" y="20" w="20" h="20" />
    </glyph>
    <glyph id="p" class="process" compartmentRef="cell">
      <bbox x="147.0" y="25" w="10" h="10" />
      <port id="p.1" x="142.0" y="30" />
      <port id="p.2" x="162.0" y="30" />
    </glyph>
    <glyph id="b" class="macromolecule" compartmentRef="cell">
      <label text="B">
        <bbox x="105.0" y="26" w="10" h="8" />
      </label>
      <bbox x="100.0" y="20" w="20" h="20" />
    </glyph>
    <glyph id="c" class="macromolecule" compartmentRef="cell">
      <label text="C">
        <bbox x="72.0" y="1" w="10" h="8" />
      </label>
      <bbox x="67.0" y="-5" w="20" h="20" />
    </glyph>
    <arc id="consume" class="consumption" source="a" target="p.1">
      <start x="30" y="30" />
      <end x="142.0" y="30" />
    </arc>
    <arc id="produce" class="production" source="p.2" target="b">
      <start x="162.0" y="30" />
      <end x="100" y="30" />
    </arc>
    <arc id="stimulate" class="stimulation" source="c" target="p">
      <start x="77" y="15" />
      <end x="152.0" y="25" />
    </arc>
  </map>
</sbgn>